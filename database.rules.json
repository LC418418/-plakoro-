{
  "_comment": [
    "POKE TOWER 嘅 Realtime Database 安全規則。",
    "",
    "⚠️ 呢個檔案淨係放喺 repo 做記錄，貼咗入 Firebase Console 先會真正生效：",
    "   Firebase Console → Realtime Database → 規則 → 貼上 → 發佈",
    "",
    "⚠️ 貼之前請先同你而家嗰份對一對。如果你之前改過（尤其係 rooms 嗰段），",
    "   照抄可能會整壞線上對戰。唔肯定就逐段比較，唔好成份蓋過去。",
    "",
    "管理員點設定：喺 Console 手動加一個節點",
    "   admins/<你嘅 uid> = true",
    "（uid 喺 Authentication → Users 嗰版睇到。呢度個 .write 係 false，",
    " 即係冇任何客戶端改得到 admins，只可以喺 Console 改。）",
    "",
    "重點：管理員權限係喺呢啲規則度執行，唔係喺 index.html。",
    "遊戲入面就算有人改咗個 JS 扮管理員，冇喺 admins 名單入面一樣讀唔到人哋嘅資料。"
  ],

  "rules": {
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read":  "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "board": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['nick','ts'])",
        "nick": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "ts":   { ".validate": "newData.isNumber()" },
        "act":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "runs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "power":{ ".validate": "newData.isNumber() && newData.val() >= 0" },
        "diff": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "badges": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
        "team": { ".validate": "newData.hasChildren()" },
        "$other": { ".validate": false }
      }
    },

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "rooms": {
      "$code": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
