// POKE TOWER — Realtime Database 安全規則
//
// 用法：Firebase Console → Realtime Database → 「規則」分頁
//       → 全選舊嘅、剷走 → 貼呢份 → 發佈
//
// rooms 嗰段係原封不動抄返你原本嗰個，冇改過。
// 新加咗嘅係 board（高塔榜）同 admins（管理員名單），
// 同埋 users 嗰度加咗一句「管理員都讀得」。
//
// 開管理員：Console →「資料」分頁 → 加節點  admins/<你嘅 uid> = true
//          （uid 喺 Authentication → Users 嗰版睇到）
// admins 係 ".write": false，即係冇任何客戶端改得到，淨係 Console 改得。
// 管理員權限係喺呢度執行，唔喺 index.html —— 改個 JS 扮管理員冇用。
{
  "rules": {

    // 每個帳戶自己嘅嘢：profile、爬塔存檔 runs/0-2、骰組 loadouts、rogue 統計。
    // 自己讀寫自己嗰份；管理員淨係讀得，改唔到人哋嘅嘢。
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read":  "$uid === auth.uid || root.child('admins').child(auth.uid).exists()",
        ".write": "$uid === auth.uid"
      }
    },

    // 高塔榜：公開摘要。登入咗就讀得晒，但淨係寫得到自己嗰格。
    // $other 設成 false ＝ 只准寫下面列明嗰幾個欄位，
    // 就算有人改個 JS 想塞多啲嘢（例如電郵）落嚟都寫唔入。
    "board": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['nick','ts'])",
        "nick":   { ".validate": "newData.isString() && newData.val().length <= 16" },
        "ts":     { ".validate": "newData.isNumber()" },
        // 八館改版：一局有 8 章，「通關」記做 9，所以上限由 5 改成 9。
        // ⚠ 呢兩條唔改嘅話，任何人行過第 5 章都會靜靜雞寫唔到榜 ——
        //   唔會報錯，個名就係唔會出現。
        "act":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
        "best":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
        "wins":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "runs":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "power":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "diff":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "badges": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
        "team":   { ".validate": "newData.hasChildren()" },
        "$other": { ".validate": false }
      }
    },

    // 管理員名單。人人讀得（個掣要靠佢決定顯唔顯示），但冇人寫得。
    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    // 線上對戰房 —— 同你原本嗰份一模一樣，冇改過。
    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    }
  }
}
